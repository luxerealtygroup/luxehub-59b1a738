{
  "version": 1,
  "sdk_version": "0.28.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://sxpfxmlxegpmfamlmjyg.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "luxehub",
      "version": "1.0.0",
      "title": "LUXEhub"
    },
    "tools": [
      {
        "name": "get_my_pipeline",
        "title": "Get my pipeline",
        "description": "List the signed-in agent's pipeline clients, with stage, deal category, projected sale amount and projected GCI.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "description": "Maximum number of pipeline clients to return."
            },
            "status": {
              "type": "string",
              "description": "Optional status filter, e.g. 'active'."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_my_deals",
        "title": "Get my deals",
        "description": "List the signed-in agent's deals, optionally filtered by stage, including deal value, commission rate and expected close date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "stage": {
              "type": "string",
              "description": "Optional deal stage filter, e.g. 'lead', 'contacted', 'showing'. Omit for all stages."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "description": "Maximum number of deals to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_my_weekly_411",
        "title": "Get my weekly 4-1-1",
        "description": "Return the signed-in agent's recent weekly 4-1-1 accountability entries: goals vs actuals, activity counts and weekly priorities.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "weeks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 26,
              "default": 4,
              "description": "How many recent weeks to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_pipeline_client",
        "title": "Add pipeline client",
        "description": "Add a new client to the signed-in agent's LUXEhub pipeline.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "client_name": {
              "type": "string",
              "minLength": 1,
              "description": "Full name of the client."
            },
            "client_type": {
              "type": "string",
              "description": "Buyer, Seller, Tenant, etc."
            },
            "deal_category": {
              "type": "string",
              "description": "Deal category, e.g. Sale or Lease."
            },
            "property_address": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "phone": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "description": "Source of business."
            },
            "projected_sale_amount": {
              "type": "number",
              "minimum": 0
            },
            "projected_gci": {
              "type": "number",
              "minimum": 0
            },
            "expected_pending_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Required ISO date (YYYY-MM-DD)."
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "client_name",
            "expected_pending_date"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "record_weekly_411_actuals",
        "title": "Record weekly 4-1-1 actuals",
        "description": "Record an agent's weekly 4-1-1 activity and database-health actuals from an external system (e.g. a Follow Up Boss weekly automation). Upserts on agent + week, so re-running a week overwrites instead of duplicating. Owners and admins only, and only for agents in their own brokerage.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "agent_email": {
              "type": "string",
              "format": "email",
              "description": "Login email of the agent in your brokerage."
            },
            "week_start": {
              "type": "string",
              "description": "ISO date (YYYY-MM-DD) inside the week; normalised to that week's Monday."
            },
            "actuals": {
              "type": "object",
              "properties": {
                "leads_received": {
                  "type": "integer",
                  "minimum": 0
                },
                "dials": {
                  "type": "integer",
                  "minimum": 0
                },
                "connects": {
                  "type": "integer",
                  "minimum": 0
                },
                "conversations": {
                  "type": "integer",
                  "minimum": 0
                },
                "texts_sent": {
                  "type": "integer",
                  "minimum": 0
                },
                "appointments_set": {
                  "type": "integer",
                  "minimum": 0
                },
                "talk_time_minutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "speed_to_first_touch_minutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "contacts_held": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Total contacts assigned to the agent."
                },
                "contacts_unstaged": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "How many of those contacts sit in the default Contact or Lead stages."
                },
                "contacts_per_live_deal": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Contacts per live deal; omit or null when the agent has no live deal."
                }
              },
              "additionalProperties": false,
              "description": "Weekly activity and database-health actuals. Omitted fields keep their existing value."
            },
            "note": {
              "type": "string",
              "maxLength": 2000,
              "description": "Short coaching line stored with the week."
            }
          },
          "required": [
            "agent_email",
            "week_start",
            "actuals"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_team_roster",
        "title": "Get team roster (admin)",
        "description": "Owners/admins only, read-only: returns every agent profile and role in the signed-in user's brokerage.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_team_goals",
        "title": "Get team goals (admin)",
        "description": "Owners/admins only, read-only: returns agent goals, production goals and business-planning goals for every agent in the signed-in user's brokerage.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "year": {
              "type": "integer",
              "description": "Optional goal year, e.g. 2027."
            },
            "agent_email": {
              "type": "string",
              "format": "email",
              "description": "Optional: limit to one agent by email."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_team_pipeline",
        "title": "Get team pipeline (admin)",
        "description": "Owners/admins only, read-only: returns pipeline clients for every agent in the signed-in user's brokerage.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 500,
              "description": "Maximum rows."
            },
            "status": {
              "type": "string",
              "description": "Optional status filter."
            },
            "agent_email": {
              "type": "string",
              "format": "email",
              "description": "Optional: limit to one agent by email."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_team_deals",
        "title": "Get team deals (admin)",
        "description": "Owners/admins only, read-only: returns deals for every agent in the signed-in user's brokerage.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "stage": {
              "type": "string",
              "description": "Optional deal stage filter."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 500,
              "description": "Maximum rows."
            },
            "agent_email": {
              "type": "string",
              "format": "email",
              "description": "Optional: limit to one agent by email."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_team_weekly_411",
        "title": "Get team weekly 4-1-1 / coaching (admin)",
        "description": "Owners/admins only, read-only: returns weekly 4-1-1 accountability entries for every agent in the signed-in user's brokerage.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "week_start_from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Earliest week start (YYYY-MM-DD)."
            },
            "week_start_to": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Latest week start (YYYY-MM-DD)."
            },
            "weeks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 52,
              "default": 8,
              "description": "Weeks back from this Monday when week_start_from is omitted."
            },
            "agent_email": {
              "type": "string",
              "format": "email",
              "description": "Optional: limit to one agent by email."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000,
              "default": 1000,
              "description": "Maximum rows."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_team_coaching_sessions",
        "title": "Get team coaching sessions (admin)",
        "description": "Owners/admins only, read-only: returns coaching sessions for every agent in the signed-in user's brokerage.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "week_from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Earliest week_of (YYYY-MM-DD)."
            },
            "agent_email": {
              "type": "string",
              "format": "email",
              "description": "Optional: limit to one agent by email."
            },
            "include_transcript": {
              "type": "boolean",
              "default": false,
              "description": "Include full transcript text."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "description": "Maximum rows."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
